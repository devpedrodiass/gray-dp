  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#7e7e7e",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Doc comment tags",
      "scope": [
        "storage.type.class.jsdoc",
        "keyword.other.phpdoc",
        "entity.name.type.instance.jsdoc"
      ],
      "settings": {
        "foreground": "#666666",
        "fontStyle": "bold italic"
      }
    },
    {
      "name": "Keywords",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.other.using"
      ],
      "settings": {
        "foreground": "#141414",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Operator keywords",
      "scope": [
        "keyword.operator.new",
        "keyword.control.new",
        "keyword.operator.expression",
        "keyword.operator.logical.python"
      ],
      "settings": {
        "foreground": "#141414",
        "fontStyle": ""
      }
    },
    {
      "name": "Module keywords",
      "scope": [
        "keyword.control.import",
        "keyword.control.export",
        "keyword.control.from",
        "keyword.control.require",
        "keyword.other.import",
        "storage.modifier.import",
        "storage.modifier.package",
        "keyword.other.use",
        "keyword.other.namespace"
      ],
      "settings": {
        "foreground": "#5c5c5c",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Storage",
      "scope": [
        "storage",
        "storage.type",
        "storage.modifier",
        "keyword.declaration",
        "keyword.function"
      ],
      "settings": {
        "foreground": "#474747",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Type keywords",
      "scope": [
        "storage.type.interface",
        "storage.type.type",
        "storage.modifier.implements",
        "storage.modifier.extends",
        "keyword.control.as",
        "keyword.control.satisfies",
        "keyword.control.type",
        "keyword.operator.expression.keyof",
        "keyword.operator.expression.infer",
        "keyword.operator.expression.is",
        "keyword.operator.type.asserts"
      ],
      "settings": {
        "foreground": "#474747",
        "fontStyle": "bold italic"
      }
    },
    {
      "name": "this / self",
      "scope": [
        "variable.language.this",
        "variable.language.self",
        "variable.language.super",
        "variable.language.special.self",
        "variable.parameter.function.language.special.self.python"
      ],
      "settings": {
        "foreground": "#474747",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator",
        "storage.type.function.arrow"
      ],
      "settings": {
        "foreground": "#5c5c5c",
        "fontStyle": ""
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation",
        "meta.brace",
        "punctuation.separator",
        "punctuation.terminator",
        "punctuation.accessor"
      ],
      "settings": {
        "foreground": "#737373",
        "fontStyle": ""
      }
    },
    {
      "name": "Functions",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call entity.name.function",
        "variable.function"
      ],
      "settings": {
        "foreground": "#262626",
        "fontStyle": ""
      }
    },
    {
      "name": "Function definitions",
      "scope": [
        "meta.definition.function entity.name.function",
        "meta.definition.method entity.name.function",
        "meta.function.python entity.name.function",
        "meta.function.php entity.name.function"
      ],
      "settings": {
        "foreground": "#262626",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Types and classes",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.other.inherited-class",
        "support.class",
        "support.type",
        "entity.name.namespace",
        "storage.type.primitive",
        "storage.type.built-in",
        "keyword.other.type.php"
      ],
      "settings": {
        "foreground": "#333333",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Type definitions",
      "scope": [
        "entity.name.type.class",
        "entity.name.type.interface",
        "entity.name.type.alias",
        "entity.name.type.enum",
        "entity.name.type.module",
        "entity.name.class"
      ],
      "settings": {
        "foreground": "#333333",
        "fontStyle": "italic underline"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "punctuation.definition.string",
        "string.template"
      ],
      "settings": {
        "foreground": "#666666",
        "fontStyle": ""
      }
    },
    {
      "name": "Template expressions",
      "scope": [
        "punctuation.definition.template-expression",
        "punctuation.section.embedded",
        "constant.character.format.placeholder"
      ],
      "settings": {
        "foreground": "#474747",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Escapes and regex",
      "scope": [
        "constant.character.escape",
        "constant.character.entity",
        "constant.character.entity punctuation",
        "string.regexp",
        "constant.other.character-class.regexp"
      ],
      "settings": {
        "foreground": "#262626",
        "fontStyle": ""
      }
    },
    {
      "name": "Regex operators",
      "scope": [
        "string.regexp keyword",
        "keyword.control.anchor.regexp",
        "string.regexp keyword.operator",
        "string.regexp punctuation",
        "string.regexp constant.other.character-class.set"
      ],
      "settings": {
        "foreground": "#262626",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Numbers and literals",
      "scope": [
        "constant.numeric",
        "constant.language",
        "keyword.other.unit",
        "constant.other.color.rgb-value",
        "constant.other.color.rgb-value punctuation.definition.constant"
      ],
      "settings": {
        "foreground": "#262626",
        "fontStyle": ""
      }
    },
    {
      "name": "Constants",
      "scope": [
        "constant.other",
        "variable.other.enummember",
        "support.constant"
      ],
      "settings": {
        "foreground": "#262626",
        "fontStyle": ""
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable",
        "variable.other",
        "variable.other.readwrite"
      ],
      "settings": {
        "foreground": "#3d3d3d",
        "fontStyle": ""
      }
    },
    {
      "name": "Parameters",
      "scope": [
        "variable.parameter",
        "meta.parameters variable"
      ],
      "settings": {
        "foreground": "#333333",
        "fontStyle": ""
      }
    },
    {
      "name": "Properties",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "meta.object-literal.key",
        "support.variable.property",
        "support.type.property-name",
        "meta.attribute.python",
        "entity.name.tag.yaml"
      ],
      "settings": {
        "foreground": "#4f4f4f",
        "fontStyle": ""
      }
    },
    {
      "name": "Tags",
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#474747",
        "fontStyle": ""
      }
    },
    {
      "name": "Components",
      "scope": [
        "support.class.component",
        "entity.name.tag.component"
      ],
      "settings": {
        "foreground": "#141414",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Attributes",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#4f4f4f",
        "fontStyle": ""
      }
    },
    {
      "name": "CSS selectors",
      "scope": [
        "entity.other.attribute-name.class",
        "entity.other.attribute-name.id"
      ],
      "settings": {
        "foreground": "#262626",
        "fontStyle": ""
      }
    },
    {
      "name": "CSS pseudo selectors",
      "scope": [
        "entity.other.attribute-name.pseudo-class",
        "entity.other.attribute-name.pseudo-element"
      ],
      "settings": {
        "foreground": "#474747",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Decorators",
      "scope": [
        "meta.decorator",
        "punctuation.decorator",
        "entity.name.function.decorator"
      ],
      "settings": {
        "foreground": "#262626",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown headings",
      "scope": [
        "markup.heading",
        "markup.heading entity.name"
      ],
      "settings": {
        "foreground": "#141414",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown bold",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#141414",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown italic",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#262626",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown strikethrough",
      "scope": [
        "markup.strikethrough"
      ],
      "settings": {
        "foreground": "#7e7e7e",
        "fontStyle": "strikethrough"
      }
    },
    {
      "name": "Markdown code",
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code"
      ],
      "settings": {
        "foreground": "#666666",
        "fontStyle": ""
      }
    },
    {
      "name": "Markdown link text",
      "scope": [
        "string.other.link"
      ],
      "settings": {
        "foreground": "#262626",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Markdown link URLs",
      "scope": [
        "markup.underline.link"
      ],
      "settings": {
        "foreground": "#666666",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Markdown quotes",
      "scope": [
        "markup.quote"
      ],
      "settings": {
