  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#6b6b6b",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Doc comment tags",
      "scope": [
        "storage.type.class.jsdoc",
        "keyword.other.phpdoc",
        "entity.name.type.instance.jsdoc"
      ],
      "settings": {
        "foreground": "#8a8a8a",
        "fontStyle": "bold italic"
      }
    },
    {
      "name": "Keywords",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.other.using"
      ],
      "settings": {
        "foreground": "#f2f2f2",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Operator keywords",
      "scope": [
        "keyword.operator.new",
        "keyword.control.new",
        "keyword.operator.expression",
        "keyword.operator.logical.python"
      ],
      "settings": {
        "foreground": "#f2f2f2",
        "fontStyle": ""
      }
    },
    {
      "name": "Module keywords",
      "scope": [
        "keyword.control.import",
        "keyword.control.export",
        "keyword.control.from",
        "keyword.control.require",
        "keyword.other.import",
        "storage.modifier.import",
        "storage.modifier.package",
        "keyword.other.use",
        "keyword.other.namespace"
      ],
      "settings": {
        "foreground": "#9a9a9a",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Storage",
      "scope": [
        "storage",
        "storage.type",
        "storage.modifier",
        "keyword.declaration",
        "keyword.function"
      ],
      "settings": {
        "foreground": "#b4b4b4",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Type keywords",
      "scope": [
        "storage.type.interface",
        "storage.type.type",
        "storage.modifier.implements",
        "storage.modifier.extends",
        "keyword.control.as",
        "keyword.control.satisfies",
        "keyword.control.type",
        "keyword.operator.expression.keyof",
        "keyword.operator.expression.infer",
        "keyword.operator.expression.is",
        "keyword.operator.type.asserts"
      ],
      "settings": {
        "foreground": "#b4b4b4",
        "fontStyle": "bold italic"
      }
    },
    {
      "name": "this / self",
      "scope": [
        "variable.language.this",
        "variable.language.self",
        "variable.language.super",
        "variable.language.special.self",
        "variable.parameter.function.language.special.self.python"
      ],
      "settings": {
        "foreground": "#b4b4b4",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator",
        "storage.type.function.arrow"
      ],
      "settings": {
        "foreground": "#9a9a9a",
        "fontStyle": ""
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation",
        "meta.brace",
        "punctuation.separator",
        "punctuation.terminator",
        "punctuation.accessor"
      ],
      "settings": {
        "foreground": "#787878",
        "fontStyle": ""
      }
    },
    {
      "name": "Functions",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call entity.name.function",
        "variable.function"
      ],
      "settings": {
        "foreground": "#dcdcdc",
        "fontStyle": ""
      }
    },
    {
      "name": "Function definitions",
      "scope": [
        "meta.definition.function entity.name.function",
        "meta.definition.method entity.name.function",
        "meta.function.python entity.name.function",
        "meta.function.php entity.name.function"
      ],
      "settings": {
        "foreground": "#dcdcdc",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Types and classes",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.other.inherited-class",
        "support.class",
        "support.type",
        "entity.name.namespace",
        "storage.type.primitive",
        "storage.type.built-in",
        "keyword.other.type.php"
      ],
      "settings": {
        "foreground": "#cfcfcf",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Type definitions",
      "scope": [
        "entity.name.type.class",
        "entity.name.type.interface",
        "entity.name.type.alias",
        "entity.name.type.enum",
        "entity.name.type.module",
        "entity.name.class"
      ],
      "settings": {
        "foreground": "#cfcfcf",
        "fontStyle": "italic underline"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "punctuation.definition.string",
        "string.template"
      ],
      "settings": {
        "foreground": "#8a8a8a",
        "fontStyle": ""
      }
    },
    {
      "name": "Template expressions",
      "scope": [
        "punctuation.definition.template-expression",
        "punctuation.section.embedded",
        "constant.character.format.placeholder"
      ],
      "settings": {
        "foreground": "#b4b4b4",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Escapes and regex",
      "scope": [
        "constant.character.escape",
        "constant.character.entity",
        "constant.character.entity punctuation",
        "string.regexp",
        "constant.other.character-class.regexp"
      ],
      "settings": {
        "foreground": "#dcdcdc",
        "fontStyle": ""
      }
    },
    {
      "name": "Regex operators",
      "scope": [
        "string.regexp keyword",
        "keyword.control.anchor.regexp",
        "string.regexp keyword.operator",
        "string.regexp punctuation",
        "string.regexp constant.other.character-class.set"
      ],
      "settings": {
        "foreground": "#dcdcdc",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Numbers and literals",
      "scope": [
        "constant.numeric",
        "constant.language",
        "keyword.other.unit",
        "constant.other.color.rgb-value",
        "constant.other.color.rgb-value punctuation.definition.constant"
      ],
      "settings": {
        "foreground": "#dcdcdc",
        "fontStyle": ""
      }
    },
    {
      "name": "Constants",
      "scope": [
        "constant.other",
        "variable.other.enummember",
        "support.constant"
      ],
      "settings": {
        "foreground": "#dcdcdc",
        "fontStyle": ""
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable",
        "variable.other",
        "variable.other.readwrite"
      ],
      "settings": {
        "foreground": "#bdbdbd",
        "fontStyle": ""
      }
    },
    {
      "name": "Parameters",
      "scope": [
        "variable.parameter",
        "meta.parameters variable"
      ],
      "settings": {
        "foreground": "#cfcfcf",
        "fontStyle": ""
      }
    },
    {
      "name": "Properties",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "meta.object-literal.key",
        "support.variable.property",
        "support.type.property-name",
        "meta.attribute.python",
        "entity.name.tag.yaml"
      ],
      "settings": {
        "foreground": "#a8a8a8",
        "fontStyle": ""
      }
    },
    {
      "name": "Tags",
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#b4b4b4",
        "fontStyle": ""
      }
    },
    {
      "name": "Components",
      "scope": [
        "support.class.component",
        "entity.name.tag.component"
      ],
      "settings": {
        "foreground": "#f2f2f2",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Attributes",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#a8a8a8",
        "fontStyle": ""
      }
    },
    {
      "name": "CSS selectors",
      "scope": [
        "entity.other.attribute-name.class",
        "entity.other.attribute-name.id"
      ],
      "settings": {
        "foreground": "#dcdcdc",
        "fontStyle": ""
      }
    },
    {
      "name": "CSS pseudo selectors",
      "scope": [
        "entity.other.attribute-name.pseudo-class",
        "entity.other.attribute-name.pseudo-element"
      ],
      "settings": {
        "foreground": "#b4b4b4",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Decorators",
      "scope": [
        "meta.decorator",
        "punctuation.decorator",
        "entity.name.function.decorator"
      ],
      "settings": {
        "foreground": "#dcdcdc",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown headings",
      "scope": [
        "markup.heading",
        "markup.heading entity.name"
      ],
      "settings": {
        "foreground": "#f2f2f2",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown bold",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#f2f2f2",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown italic",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#dcdcdc",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown strikethrough",
      "scope": [
        "markup.strikethrough"
      ],
      "settings": {
        "foreground": "#6b6b6b",
        "fontStyle": "strikethrough"
      }
    },
    {
      "name": "Markdown code",
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code"
      ],
      "settings": {
        "foreground": "#8a8a8a",
        "fontStyle": ""
      }
    },
    {
      "name": "Markdown link text",
      "scope": [
